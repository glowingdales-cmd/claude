generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; statuses are plain strings
// constrained by the TS union types in src/lib/constants.ts.
model Reservation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  fullName      String
  email         String
  phone         String
  roomType      String
  checkIn       DateTime
  checkOut      DateTime
  guests        Int      @default(1)
  notes         String?
  status        String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED | COMPLETED
  paymentMethod String   @default("CASH_ON_ARRIVAL") // CASH_ON_ARRIVAL | ORANGE_MONEY | MTN_MOMO
  paymentStatus String   @default("NONE") // NONE | AWAITING_CONFIRMATION | CONFIRMED | FAILED
  paymentRef    String?
  depositAmount Int?

  @@index([status])
  @@index([checkIn])
}

model ContactMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW") // NEW | READ | REPLIED
}

model AdminUser {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String
  name         String?
}

// Photos shown in the room carousels and the home-page gallery, managed from
// /admin/photos. `album` is "gallery" or "room:<slug>" (see PHOTO_ALBUMS).
// `url` is either a bundled /photos/* file or an uploaded /media/* file.
model Photo {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  album     String
  url       String
  alt       String
  position  Int

  @@index([album, position])
}
